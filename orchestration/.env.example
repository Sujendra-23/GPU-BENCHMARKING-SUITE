# Local-dev Airflow environment for gpu-benchmarking-suite orchestration.
# Copy this to .env before first run (docker compose reads .env, not
# .env.example) and fill in the two host/instance-specific values below.
# AIRFLOW_UID and FERNET_KEY are intentionally not committed - see README.md
# "Orchestration (Airflow)".
AIRFLOW_UID=50000
# Replace 50000 above with your own `id -u` on Linux, or leave as-is on
# macOS/Windows (see https://airflow.apache.org/docs/apache-airflow/stable/howto/docker-compose/index.html#setting-the-right-airflow-user).
AIRFLOW_PROJ_DIR=.
# Generate your own: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FERNET_KEY=REPLACE_ME_WITH_A_GENERATED_FERNET_KEY
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# numpy is needed for harness/benchmark.py's CPU self-test fallback
# (build_selftest_runner) to actually run in this GPU-less container.
# NOTE: _PIP_ADDITIONAL_REQUIREMENTS re-installs on every container start -
# fine for this local quick-start, not for production (see docker-compose.yaml header).
_PIP_ADDITIONAL_REQUIREMENTS=numpy
