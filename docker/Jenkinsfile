pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Lint / Syntax') {
            steps {
                sh 'python3 -m py_compile harness/*.py training/*.py compilers/*.py serving/*.py scripts/*.py kernels/*.py kernels/cuda/*.py kernels/triton/*.py tests/*.py'
            }
        }

        // These stages run on any Jenkins agent, GPU or not - they're the
        // deterministic, hardware-independent regression checks that
        // should gate every commit.
        stage('Validation Gate Self-Test') {
            steps {
                sh 'python3 harness/validate.py --self-test'
            }
        }

        stage('Performance-per-watt Check') {
            steps {
                sh 'python3 harness/perf_per_watt.py --self-test'
                sh 'python3 harness/perf_per_watt.py --check-readme'
            }
        }

        stage('Serving and Compiler Unit Checks') {
            steps {
                sh 'python3 -m pip install pytest -r serving/requirements-client.txt'
                sh 'python3 -m pytest -q tests/test_serving.py tests/test_compilers.py tests/test_extensions.py'
            }
        }

        stage('OpenCL Kernel Correctness') {
            steps {
                sh 'cd kernels/opencl && make run'
            }
        }

        stage('Compiler Comparison (informational)') {
            steps {
                sh 'cd kernels/stencil && make compare'
            }
        }

        // Only runs on agents labeled 'gpu' - a real cluster would have a
        // dedicated node pool with NVIDIA drivers/CUDA toolkit installed.
        stage('CUDA Build + Benchmark') {
            agent { label 'gpu' }
            steps {
                sh 'nvcc -O3 -o kernels/cuda/matmul_cuda kernels/cuda/matmul.cu'
                sh 'kernels/cuda/matmul_cuda 1024 1024 1024'
                sh 'python3 harness/benchmark.py --model resnet50 --batch-sizes 1,8,32,64 --precisions fp32,fp16'
                sh 'python3 -m pip install -r requirements-kernels.txt'
                sh 'python3 -m pytest -q tests/test_kernels.py'
                sh 'python3 -m harness.kernel_benchmark'
                sh 'python3 -m compilers.torch_compile'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '**/*.csv', allowEmptyArchive: true
            archiveArtifacts artifacts: 'results/**/*.json,results/**/*.hlo,results/**/*.mlir', allowEmptyArchive: true
        }
    }
}
